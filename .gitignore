# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# dev を止めずに確認ビルドを出す先 (next.config.ts の distDir を一時的に
# 差し替えて使う)。無視しないと Tailwind v4 が中の compiled chunk まで走査し、
# 壊れたクラスを拾って dev の CSS が落ちる。
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 値の入っていない雛形だけは追跡する
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
